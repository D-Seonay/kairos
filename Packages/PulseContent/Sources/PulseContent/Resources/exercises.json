  "exercises": [
    {
      "id": "bench-press-barbell",
      "name": {
        "fr": "Développé couché à la barre",
        "en": "Barbell Bench Press"
      },
      "primaryMuscles": [
        "chest"
      ],
      "secondaryMuscles": [
        "frontDelts",
        "triceps"
      ],
      "equipment": "barbell",
      "pattern": "horizontalPush",
      "region": "upper",
      "isCompound": true,
      "isUnilateral": false,
      "loadKind": "external",
      "defaultIncrementKg": 2.5,
      "defaultRestSeconds": 120,
      "cues": {
        "fr": [
          "Omoplates serrées et abaissées sur le banc.",
          "Barre au niveau du bas des pectoraux, coudes à 45°.",
          "Pieds ancrés, pousser le sol pendant la montée."
        ]
      },
      "mistakes": {
        "fr": [
          "Rebondir la barre sur la poitrine.",
          "Décoller les fesses du banc.",
          "Coudes écartés à 90°, épaules exposées."
        ]
      },
      "alternatives": [
        "chest-press-machine",
        "bench-press-dumbbell",
        "incline-chest-press-machine"
      ]
    },
    {
      "id": "bench-press-dumbbell",
      "name": {
        "fr": "Développé couché aux haltères",
        "en": "Dumbbell Bench Press"
      },
      "primaryMuscles": [
        "chest"
      ],
      "secondaryMuscles": [
        "frontDelts",
        "triceps"
      ],
      "equipment": "dumbbell",
      "pattern": "horizontalPush",
      "region": "upper",
      "isCompound": true,
      "isUnilateral": false,
      "loadKind": "external",
      "defaultIncrementKg": 2.5,
      "defaultRestSeconds": 90,
      "cues": {
        "fr": [
          "Haltères au niveau de la poitrine, poignets droits.",
          "Monter en légère convergence sans cogner les haltères.",
          "Omoplates serrées pendant toute la série."
        ]
      },
      "mistakes": {
        "fr": [
          "Descendre trop bas et tirer sur les épaules.",
          "Laisser les coudes partir à 90°."
        ]
      },
      "alternatives": [
        "bench-press-barbell",
        "chest-press-machine",
        "push-up"
      ]
    },
    {
      "id": "incline-bench-press-dumbbell",
      "name": {
        "fr": "Développé incliné aux haltères",
        "en": "Incline Dumbbell Bench Press"
      },
      "primaryMuscles": [
        "chest",
        "frontDelts"
      ],
      "secondaryMuscles": [
        "triceps"
      ],
      "equipment": "dumbbell",
      "pattern": "horizontalPush",
      "region": "upper",
      "isCompound": true,
      "isUnilateral": false,
      "loadKind": "external",
      "defaultIncrementKg": 2.5,
      "defaultRestSeconds": 90,
      "cues": {
        "fr": [
          "Banc incliné à 30° environ, pas plus.",
          "Descendre les haltères vers le haut des pectoraux.",
          "Garder le bas du dos en contact avec le banc."
